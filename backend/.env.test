# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# The suite appends "_test" to this database name (see doctrine.yaml).
DATABASE_URL="postgresql://app:app@127.0.0.1:5432/mosaiq?serverVersion=16&charset=utf8"

MAILER_DSN="null://null"

# Sprint 1: lower limits make the throttling tests deterministic.
AUTH_TOKEN_TTL=604800
AUTH_THROTTLE_ENABLED=1
AUTH_LOGIN_MAX_ATTEMPTS=3
AUTH_LOGIN_IP_MAX_ATTEMPTS=20
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_REGISTER_MAX_ATTEMPTS=5
AUTH_REGISTER_WINDOW_SECONDS=3600

# Sprint 1A: the suite talks to a scripted fake provider
# (config/services_test.yaml), never to the network. These values only satisfy
# the real adapter's configuration; it is not the service used by tests.
AI_ENABLED=1
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://provider.invalid/v1
AI_MODEL=test-model
AI_PROVIDER_API_KEY=
AI_TIMEOUT_SECONDS=20
AI_RATE_LIMIT_PER_10_MINUTES=5
AI_RATE_LIMIT_PER_HOUR=20
AI_RATE_LIMIT_GLOBAL_PER_MINUTE=60
